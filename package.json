{
  "name": "inventory-sales-pro",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "dev:desktop": "concurrently -k \"npm:dev\" \"wait-on tcp:3000 && node ./node_modules/electron/cli.js .\"",
    "start:desktop": "node ./node_modules/electron/cli.js .",
    "pack": "node ./node_modules/vite/bin/vite.js build && node ./pack.cjs",
    "build:android": "powershell -ExecutionPolicy Bypass -File ./build-android.ps1"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.0",
    "@capacitor/android": "^8.1.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.1",
    "@fontsource/inter": "^5.0.17",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^31.2.0",
    "electron-builder": "^25.1.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.inventory-sales-pro.app",
    "productName": "Inventory & Sales Pro",
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "certificateFile": null,
      "certificatePassword": null,
      "sign": null
    }
  }
}
